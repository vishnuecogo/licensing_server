# Licensing Server Environment (.env.local)

# Container names prefix
CONTAINER_PREFIX=eva_lic

# Host IP / domain used in logs or links
HOST_IP=evalicense.ecogo.ai

# Database settings
DATABASE_HOST=licensing-db
DATABASE_USER=evadb
DATABASE_PASSWORD=evadbpass
DATABASE_NAME=licensing
INTERNAL_DATABASE_PORT=5432
DATABASE_PORT=5434  # Optional for host debugging

# Backend (FastAPI) ports
INTERNAL_BACKEND_PORT=8000
BACKEND_PORT=8889

# Frontend (Nginx or React) ports
INTERNAL_FRONTEND_PORT=80
FRONTEND_PORT=3334

# App settings
APP_NAME=Evachatbot Licensing Server
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=1

# CORS origins — allow requests from your domain and dev machines
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://evalicense.ecogo.ai

# Frontend origins — used to allow access to frontend UI
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:8080,http://evalicense.ecogo.ai,http://192.168.0.10:3334

# Auth settings
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Health checks
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_START_PERIOD=10s
